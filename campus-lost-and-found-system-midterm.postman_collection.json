    {
      "name": "D - Business rules",
      "item": [
        {"name": "D1 - Past claim date is rejected", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"claimDate\":\"2026-10-20\",\"itemName\":\"Old claim\",\"description\":\"Past date test\",\"student\":{\"id\":\"{{studentIgorId}}\"},\"custodian\":{\"id\":\"{{custodianAdaId}}\"}}"}, "url": "{{baseUrl}}/api/item-claims/save", "description": "Expected HTTP 400: Item claim date cannot be in the past."}},
        {"name": "D1 - Custodian duplicate date is rejected", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"claimDate\":\"2026-10-30\",\"itemName\":\"Duplicate test\",\"description\":\"Ada already has an active claim today\",\"student\":{\"id\":\"{{studentBellaId}}\"},\"custodian\":{\"id\":\"{{custodianAdaId}}\"}}"}, "url": "{{baseUrl}}/api/item-claims/save", "description": "Expected HTTP 409: Custodian already handles a claim on that date."}},
        {"name": "D2 - Reported claim becomes MATCHED", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/item-claims/{{claim4Id}}/status?status=MATCHED", "description": "Expected HTTP 200: Item claim status updated successfully."}},
        {"name": "D2 - Final RETURNED claim cannot reopen", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/item-claims/{{claim2Id}}/status?status=REPORTED", "description": "Expected HTTP 400: Cannot change status from RETURNED to REPORTED."}},
        {"name": "D2 - Unknown claim returns 404", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/item-claims/00000000-0000-0000-0000-000000000001/status?status=MATCHED", "description": "Expected HTTP 404: The item claim with that id does not exist."}},
        {"name": "D3 - Add Electronics to Grace", "request": {"method": "PUT", "url": "{{baseUrl}}/api/custodians/{{custodianGraceId}}/item-categories/{{categoryElectronicsId}}", "description": "Expected HTTP 200: Item category added to the custodian."}},
        {"name": "D3 - Duplicate category returns 409", "request": {"method": "PUT", "url": "{{baseUrl}}/api/custodians/{{custodianGraceId}}/item-categories/{{categoryElectronicsId}}", "description": "Expected HTTP 409: The custodian already has that item category."}},
        {"name": "D4 - Occupied desk returns 409", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/custodians/{{custodianAdaId}}/found-desk?deskNumber=2", "description": "Expected HTTP 409: That found desk is taken by another custodian."}},
        {"name": "D4 - Move Ada to free desk 4", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/custodians/{{custodianAdaId}}/found-desk?deskNumber=4", "description": "Expected HTTP 200: Found desk changed successfully."}}
      ]

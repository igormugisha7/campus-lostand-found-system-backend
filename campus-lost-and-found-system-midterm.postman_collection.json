        {"name": "E3 - Read receipts and save receipt ID", "request": {"method": "GET", "url": "{{baseUrl}}/api/return-receipts/student/24568"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const rows = pm.response.json();", "pm.collectionVariables.set('returnReceiptId', rows[0].id);"]}}]},
        {"name": "E3 - Delete return receipt", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/return-receipts/delete/{{returnReceiptId}}", "description": "Expected HTTP 200: Return receipt deleted successfully."}},
        {"name": "E3 - Unknown receipt returns 404", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/return-receipts/delete/00000000-0000-0000-0000-000000000001", "description": "Expected HTTP 404: The return receipt with that id does not exist."}}
      ]

        {"name": "E1 - Non-returned claim cannot get receipt", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"proofType\":\"Student ID card\",\"remarks\":\"This claim is still reported\",\"itemsReturned\":1}"}, "url": "{{baseUrl}}/api/return-receipts/save?itemClaimId={{claim4Id}}", "description": "Expected HTTP 400: Return receipts are only for RETURNED item claims."}},
        {"name": "E1 - Unknown claim returns 404", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"proofType\":\"Student ID card\",\"remarks\":\"Missing claim test\",\"itemsReturned\":1}"}, "url": "{{baseUrl}}/api/return-receipts/save?itemClaimId=00000000-0000-0000-0000-000000000001", "description": "Expected HTTP 404: The item claim with that id does not exist."}},
        {"name": "E2 - Read receipts for student 24568", "request": {"method": "GET", "url": "{{baseUrl}}/api/return-receipts/student/24568"}},
